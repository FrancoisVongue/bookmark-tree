{
  "manifest_version": 3,
  "name": "Tree",
  "version": "0.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "webNavigation",
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "favicon"
  ],
  "background": {
    "service_worker": "src/worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "__MSG_actionTitle__"
    },
    "new-child": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "__MSG_newChild__"
    },
    "new-sibling": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "__MSG_newSibling__"
    }
  },
  "optional_permissions": [
    "bookmarks"
  ]
}